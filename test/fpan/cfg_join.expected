# Block arguments join the two predecessor states.
// argument: %3 is {(s = +, e = -24), (s = +, e = 0)}

# The joined state contains nearby operands, so SE-I cannot prove identity for
# every concrete pair it represents.
!call @__fpan_twosum_f32(%3, %2) : (f32, f32) -> (f32, f32) // %4#0 is

# The second join also contains pairs outside SE-I's sufficient condition.
// argument: %2 is {(s = +, e = -26), (s = +, e = 0)}
!call @__fpan_twosum_f32(%2, %0) : (f32, f32) -> (f32, f32) // %3#0 is
