llvm.func @pos_zero() -> f32 {
  %0 = llvm.mlir.constant(0.000000e+00 : f32) : f32 // %0 is zero or positive
  llvm.return %0 : f32
}

llvm.func @neg_zero() -> f32 {
  %0 = llvm.mlir.constant(-0.000000e+00 : f32) : f32 // %0 is negative or zero
  llvm.return %0 : f32
}

llvm.func @pos_one() -> f32 {
  %0 = llvm.mlir.constant(1.000000e+00 : f32) : f32 // %0 is positive
  llvm.return %0 : f32
}

llvm.func @neg_one() -> f32 {
  %0 = llvm.mlir.constant(-1.000000e+00 : f32) : f32 // %0 is negative
  llvm.return %0 : f32
}
